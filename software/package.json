{
  "name": "nand-computer-software",
  "version": "0.1.0",
  "private": true,
  "description": "Software track: Hack assembler, behavioral ISA interpreter (hackrun), VM translator, Jack compiler, Jack OS subset, Tetris. Zero runtime dependencies.",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\"",
    "hackasm": "node dist/src/cli/hackasm.js",
    "hackrun": "node dist/src/cli/hackrun.js",
    "vmc": "node dist/src/cli/vmc.js",
    "jackc": "node dist/src/cli/jackc.js",
    "build:tetris": "node tools/build-tetris.mjs",
    "build:demo": "tsc -p tsconfig.demo.json && node tools/prepare-demo.mjs",
    "record:tetris": "node tools/record-tetris.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "^5.9.3"
  }
}
