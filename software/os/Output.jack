/**
 * Output: text on an 8x8 character grid (64 columns x 32 rows).
 * printChar renders glyphs in white with a black cell background by direct
 * word writes (8 word writes per char, no per-pixel calls).
 * Cursor wraps at the right edge; at the bottom it clamps (no scrolling).
 */
class Output {
    static int curX;          // 0..63
    static int curY;          // 0..31
    static Array bmask;       // bmask[b] = 0x80 >> b
    static String intStr;     // scratch for printInt (allocated once)

    function void init() {
        let bmask = Array.new(8);
        let bmask[7] = 1;
        let bmask[6] = 2;
        let bmask[5] = 4;
        let bmask[4] = 8;
        let bmask[3] = 16;
        let bmask[2] = 32;
        let bmask[1] = 64;
        let bmask[0] = 128;
        do OutputFont.init();
        let intStr = String.new(7);
        let curX = 0;
        let curY = 0;
        do Screen.clearScreen();
        return;
    }

    function void moveCursor(int i, int j) {
        if (i < 0) { let i = 0; }
        if (i > 63) { let i = 63; }
        if (j < 0) { let j = 0; }
        if (j > 31) { let j = 31; }
        let curX = i;
        let curY = j;
        return;
    }

    function int getCursorX() {
        return curX;
    }

    function int getCursorY() {
        return curY;
    }

    /**
     * Glyph index for an ASCII code. Table order: space ! - . : 0-9 A-Z.
     * Lowercase -> uppercase; anything else -> blank (space glyph).
     */
    function int glyphOf(int c) {
        if ((c < 32) | (c > 126)) {
            return 0;
        }
        if (c > 96) {
            if (c < 123) {
                let c = c - 32; // lowercase -> uppercase
            }
        }
        if (c = 33) {
            return 1;
        }
        if (c = 45) {
            return 2;
        }
        if (c = 46) {
            return 3;
        }
        if (c = 58) {
            return 4;
        }
        if ((c > 47) & (c < 58)) {
            return (c - 48) + 5;
        }
        if ((c > 64) & (c < 91)) {
            return (c - 65) + 15;
        }
        return 0; // blank for all other characters
    }

    /**
     * Draw glyph g at char cell (cx, cy). One cell = 8px, byte-aligned within a
     * screen word: even column -> high byte, odd column -> low byte.
     */
    function void drawGlyph(int g, int cx, int cy) {
        var int px;
        var int wordAddr;
        var int rowBase;
        var int p;
        var int ci;
        var int cell;
        var int rowA;
        var int rowB;
        var int r;
        var int b;
        var int bytePat;
        var int old;
        var int shiftHi; // 1 if high byte (even column)
        let px = cx * 8;
        let shiftHi = 1 - Screen.bitOf(px); // 0 for even px (high byte), 8 for odd
        let rowBase = 16384 + (cy * 32) + Screen.wordOf(px);
        let ci = 0;
        while (ci < 4) {
            let cell = OutputFont.get(g, ci);
            let rowA = Math.divide(cell, 256);
            let rowB = cell - (rowA * 256);
            // rows 2*ci and 2*ci+1: one screen row = 32 words further down
            let r = (ci + ci) * 32;
            let p = rowBase + r;
            let old = Memory.peek(p);
            if (shiftHi = 1) {
                let bytePat = Math.multiply(rowA, 256);
                do Memory.poke(p, (old & 255) | bytePat);
            } else {
                do Memory.poke(p, (old & -256) | rowA);
            }
            let p = rowBase + r + 32;
            let old = Memory.peek(p);
            if (shiftHi = 1) {
                let bytePat = Math.multiply(rowB, 256);
                do Memory.poke(p, (old & 255) | bytePat);
            } else {
                do Memory.poke(p, (old & -256) | rowB);
            }
            let ci = ci + 1;
        }
        return;
    }

    function void printChar(int c) {
        do drawGlyph(Output.glyphOf(c), curX, curY);
        let curX = curX + 1;
        if (curX = 64) {
            let curX = 0;
            let curY = curY + 1;
            if (curY = 32) {
                let curY = 31; // clamp: no scrolling
            }
        }
        return;
    }

    function void printString(String s) {
        var int i;
        var int n;
        let n = s.length();
        let i = 0;
        while (i < n) {
            do printChar(s.charAt(i));
            let i = i + 1;
        }
        return;
    }

    function void printInt(int n) {
        do intStr.setInt(n);
        do printString(intStr);
        return;
    }

    function void println() {
        do printChar(13); // reuses cursor wrap logic via a control char -> glyphOf maps to blank
        let curX = 0;
        let curY = curY + 1;
        if (curY = 32) {
            let curY = 31;
        }
        return;
    }

    function void clear() {
        do Screen.clearScreen();
        let curX = 0;
        let curY = 0;
        return;
    }
}
