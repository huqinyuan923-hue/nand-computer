/**
 * Output: text on an 8x8 character grid (64 columns x 32 rows).
 * printChar renders glyphs by direct screen-word writes (one byte per row).
 * Cursor wraps at the right edge; at the bottom it clamps (no scrolling).
 * (Lean ROM build: printChar/printString/printInt/moveCursor + getters.)
 */
class Output {
    static int curX;          // 0..63
    static int curY;          // 0..31
    static String intStr;     // scratch for printInt (allocated once)

    function void init() {
        do OutputFont.init();
        let intStr = String.new(7);
        let curX = 0;
        let curY = 0;
        do Screen.clearScreen();
        return;
    }

    function void moveCursor(int i, int j) {
        if (i < 0) {
            let i = 0;
        }
        if (~(i < 64)) {
            let i = 63;
        }
        if (j < 0) {
            let j = 0;
        }
        if (~(j < 32)) {
            let j = 31;
        }
        let curX = i;
        let curY = j;
        return;
    }

    function int getCursorX() {
        return curX;
    }

    function int getCursorY() {
        return curY;
    }

    /**
     * Glyph index for an ASCII code. Table order: space - 0-9 A C E G I L M O R S T V
     * (24 glyphs). Lowercase -> uppercase; anything else -> blank (space glyph).
     */
    function int glyphOf(int c) {
        if (c > 96) {
            if (c < 123) {
                let c = c - 32; // lowercase -> uppercase
            }
        }
        if ((c < 32) | (c > 126)) {
            return 0;
        }
        if ((c > 47) & (c < 58)) {
            return (c - 48) + 1;
        }
        if (c = 65) {
            return 11;
        }
        if (c = 67) {
            return 12;
        }
        if (c = 69) {
            return 13;
        }
        if (c = 71) {
            return 14;
        }
        if (c = 73) {
            return 15;
        }
        if (c = 76) {
            return 16;
        }
        if (c = 77) {
            return 17;
        }
        if (c = 79) {
            return 18;
        }
        if (c = 82) {
            return 19;
        }
        if (c = 83) {
            return 20;
        }
        if (c = 84) {
            return 21;
        }
        if (c = 86) {
            return 22;
        }
        return 0; // blank for all other characters
    }

    /**
     * Draw glyph g at char cell (cx, cy). One cell = 8px; a glyph row is one
     * byte: high byte of the screen word for even columns, low for odd.
     */
    function void drawGlyph(int g, int cx, int cy) {
        var int rowBase;
        var int p;
        var int ci;
        var int cell;
        var int rowA;
        var int rowB;
        var int r;
        var int bytePat;
        var int old;
        var int hi; // 1 if even column (high byte)
        let hi = Screen.bitOf(cx * 8); // 0 = even column (high byte)
        let rowBase = 16384 + (cy * 256) + Screen.wordOf(cx * 8);
        let ci = 0;
        while (ci < 4) {
            let cell = OutputFont.get(g, ci);
            let rowA = Math.divide(cell, 256);
            let rowB = cell - (rowA * 256);
            // rows 2*ci and 2*ci+1: one screen row = 32 words further down
            let r = (ci + ci) * 32;
            if (hi = 0) {
                let bytePat = Math.multiply(rowA, 256);
                let p = rowBase + r;
                let old = Memory.peek(p);
                do Memory.poke(p, (old & 255) | bytePat);
                let bytePat = Math.multiply(rowB, 256);
                let p = p + 32;
                let old = Memory.peek(p);
                do Memory.poke(p, (old & 255) | bytePat);
            } else {
                let p = rowBase + r;
                let old = Memory.peek(p);
                do Memory.poke(p, (old & -256) | rowA);
                let p = p + 32;
                let old = Memory.peek(p);
                do Memory.poke(p, (old & -256) | rowB);
            }
            let ci = ci + 1;
        }
        return;
    }

    function void printChar(int c) {
        do drawGlyph(glyphOf(c), curX, curY);
        let curX = curX + 1;
        if (~(curX < 64)) {
            let curX = 0;
            let curY = curY + 1;
            if (~(curY < 32)) {
                let curY = 31; // clamp: no scrolling
            }
        }
        return;
    }

    function void printString(String s) {
        var int i;
        var int n;
        let n = s.length();
        let i = 0;
        while (i < n) {
            do printChar(s.charAt(i));
            let i = i + 1;
        }
        return;
    }

    function void printInt(int n) {
        do intStr.setInt(n);
        do printString(intStr);
        return;
    }

}
