/**
 * Memory: heap allocator (RAM 2048..HEAP_TOP), first-fit free list.
 * Block layout: [size, next] header (size includes the 2 header cells);
 * alloc returns header+2. RAM 16128..16135 (0x3F00..0x3F07) is reserved for
 * debug instrumentation (Tetris gravity recording), see HEAP_TOP.
 */
class Memory {
    static int freeHead;      // first free block address, 0 = none
    static int freeBase;      // initialized flag

    static Array dbg;         // debug mirror at 0x3F00 (8 cells, see watch tooling)

    /** Heap top: RAM 2048..HEAP_TOP-1 usable. */
    function int heapTop() {
        return 16128;
    }

    function void init() {
        if (freeBase = 0) {
            let freeHead = 2048;
            do Memory.pokeFree(2048, 16128 - 2048); // size
            do Memory.pokeFree(2049, 0);            // next
            let freeBase = 1;
        }
        return;
    }

    /* raw pokes restricted to the free-list area (used by init only) */
    function void pokeFree(int addr, int value) {
        var Array p;
        let p = addr;
        let p[0] = value;
        return;
    }

    /** Debug: write value to debug cell 0..7 (0x3F00+cell). Used by the game. */
    function void dbgSet(int cell, int value) {
        var Array p;
        let p = 16128 + cell;
        let p[0] = value;
        return;
    }

    function int alloc(int size) {
        var int prev;
        var int cur;
        var int found;
        var int sizeNeeded;
        var int rest;
        if (size < 1) {
            return 0; // invalid size: caller bug, return null pointer
        }
        let sizeNeeded = size + 2;
        let prev = 0;
        let cur = freeHead;
        while (~(cur = 0)) {
            if (~(Memory.blockSize(cur) < sizeNeeded)) {
                let rest = Memory.blockSize(cur) - sizeNeeded;
                if (~(rest < 3)) {
                    // split: new free block after the allocated one
                    do Memory.pokeFree(cur + sizeNeeded, rest);
                    do Memory.pokeFree(cur + sizeNeeded + 1, Memory.blockNext(cur));
                    let found = cur + sizeNeeded;
                    if (prev = 0) {
                        let freeHead = found;
                    } else {
                        do Memory.pokeFree(prev + 1, found);
                    }
                } else {
                    // take whole block
                    if (prev = 0) {
                        let freeHead = Memory.blockNext(cur);
                    } else {
                        do Memory.pokeFree(prev + 1, Memory.blockNext(cur));
                    }
                }
                do Memory.pokeFree(cur, sizeNeeded); // allocated size in header
                return cur + 2;
            }
            let prev = cur;
            let cur = Memory.blockNext(cur);
        }
        return 0; // out of memory
    }

    function int blockSize(int block) {
        var Array p;
        let p = block;
        return p[0];
    }

    function int blockNext(int block) {
        var Array p;
        let p = block + 1;
        return p[0];
    }

    function void dealloc(int addr) {
        var int block;
        if (addr < 2050) {
            return;
        }
        let block = addr - 2;
        // insert at head; adjacent-block coalescing omitted (documented limitation)
        do Memory.pokeFree(block + 1, freeHead);
        let freeHead = block;
        return;
    }

    function int peek(int addr) {
        var Array p;
        let p = addr;
        return p[0];
    }

    function void poke(int addr, int value) {
        var Array p;
        let p = addr;
        let p[0] = value;
        return;
    }
}
