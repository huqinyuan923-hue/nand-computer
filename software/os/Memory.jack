/**
 * Memory: heap allocator (RAM 2048..16127), first-fit free list.
 * Block layout: [size, next] header (size includes the 2 header cells);
 * alloc returns header+2. RAM 16128..16135 (0x3F00..0x3F07) is reserved for
 * debug instrumentation (see dbgSet).
 * (Lean build: block header access is inlined Array arithmetic.)
 */
class Memory {
    static int freeHead;      // first free block address, 0 = none
    static int freeBase;      // initialized flag

    /** Debug: write value to debug cell 0..7 (0x3F00+cell). Used by the game. */
    function void dbgSet(int cell, int value) {
        var Array p;
        let p = 16128 + cell;
        let p[0] = value;
        return;
    }

    function void init() {
        var Array b;
        if (freeBase = 0) {
            let b = 2048;
            let b[0] = 14080; // total size: 16128 - 2048 (includes header cells)
            let b[1] = 0;     // next
            let freeHead = 2048;
            let freeBase = 1;
        }
        return;
    }

    function int alloc(int size) {
        var Array h;
        var Array rest;
        var Array curp;
        var int sizeNeeded;
        var int prev;
        var int cur;
        var int csize;
        if (size < 1) {
            return 0; // invalid size: caller bug, return null pointer
        }
        let sizeNeeded = size + 2;
        let prev = 0;
        let cur = freeHead;
        while (~(cur = 0)) {
            let h = cur;
            let curp = cur;
            let csize = h[0];
            if (~(csize < sizeNeeded)) {
                let rest = cur + sizeNeeded;
                if (~(csize - sizeNeeded < 3)) {
                    // split: new free block after the allocated one
                    let rest[0] = csize - sizeNeeded;
                    let rest[1] = h[1];
                    if (prev = 0) {
                        let freeHead = rest;
                    } else {
                        let h = prev;
                        let h[1] = rest;
                    }
                } else {
                    // take whole block: unlink cur from the free list
                    if (prev = 0) {
                        let freeHead = h[1];
                    } else {
                        let h = prev;
                        let h[1] = curp[1];
                    }
                    let sizeNeeded = csize; // use whole block (keeps header true)
                }
                let h = cur;
                let h[0] = sizeNeeded; // allocated size in header
                return cur + 2;
            }
            let prev = cur;
            let cur = curp[1];
        }
        return 0; // out of memory
    }

    function void dealloc(int addr) {
        var Array b;
        if (addr < 2050) {
            return;
        }
        let b = addr - 2;
        let b[1] = freeHead; // insert at head; no coalescing (documented)
        let freeHead = addr - 2;
        return;
    }

    function int peek(int addr) {
        var Array p;
        let p = addr;
        return p[0];
    }

    function void poke(int addr, int value) {
        var Array p;
        let p = addr;
        let p[0] = value;
        return;
    }
}
