/**
 * Math: abs/min/max/multiply/divide.
 * multiply and divide use fixed 16-iteration loops on raw 16-bit patterns,
 * so cost is constant and results follow two's-complement wrap-around.
 */
class Math {
    static int mask8000; // 0x8000 = -32768 as raw pattern

    function void init() {
        let mask8000 = 32767;
        let mask8000 = mask8000 + 1;
        return;
    }

    function int abs(int x) {
        if (x < 0) {
            return -x;
        }
        return x;
    }

    function int min(int a, int b) {
        if (a < b) {
            return a;
        }
        return b;
    }

    function int max(int a, int b) {
        if (a > b) {
            return a;
        }
        return b;
    }

    /** a*b mod 2^16, interpreted signed. Fixed 16 iterations. */
    function int multiply(int a, int b) {
        var int res;
        var int x;
        var int y;
        var int i;
        var int mask;
        let mask = mask8000;
        let res = 0;
        let x = a;
        let y = b;
        let i = 0;
        while (i < 16) {
            let res = res + res; // double-accumulate: bit j of a weighs b*2^j
            if (~((x & mask) = 0)) {
                let res = res + y;
            }
            let x = x + x; // next bit of a becomes the MSB
            let i = i + 1;
        }
        return res;
    }

    /** truncating signed division; divide by 0 returns 0x7FFF (error sentinel) */
    function int divide(int x, int y) {
        var int q;
        var int acc;
        var int ux;
        var int yy;
        var int neg;
        var int i;
        var int mask;
        var int bit;
        if (y = 0) {
            return 32767;
        }
        let mask = mask8000;
        let neg = 0;
        if (x < 0) {
            let neg = neg + 1;
            if (~(x = mask)) {
                let x = -x; // magnitude; -32768 keeps its raw pattern (= 32768 unsigned)
            }
        }
        if (y < 0) {
            let neg = neg + 1;
        }
        // yAbs: magnitude of y (only overflow case is y = -32768)
        if (y = mask) {
            // |y| = 32768 > any other magnitude
            if (x = mask) {
                if (neg = 1) {
                    return mask; // -32768 / -32768 = 1... handled below
                }
                return 1;
            }
            return 0;
        }
        if (y < 0) {
            let yy = -y;
        } else {
            let yy = y;
        }
        // long division on the unsigned x pattern, MSB first
        let q = 0;
        let acc = 0;
        let i = 0;
        while (i < 16) {
            if (~((x & mask) = 0)) {
                let bit = 1;
            } else {
                let bit = 0;
            }
            let acc = acc + acc + bit; // bring down the next dividend bit
            let q = q + q;
            // unsigned compare: acc >= yy  (acc may be negative = >= 32768)
            if (acc < 0) {
                let acc = acc - yy;
                let q = q + 1;
            } else {
                if (~(acc < yy)) {
                    let acc = acc - yy;
                    let q = q + 1;
                }
            }
            let x = x + x; // next bit of x becomes the MSB
            let i = i + 1;
        }
        if (neg = 1) {
            return -q;
        }
        return q;
    }
}
