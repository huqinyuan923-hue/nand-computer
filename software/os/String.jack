/**
 * String: fixed-capacity string of 16-bit chars stored in an Array.
 * (Lean ROM build: new/appendChar/charAt/length/setInt/dispose only —
 * these are what the compiler and Output need.)
 */
class String {
    field int maxLength;
    field int len;
    field Array data;

    constructor String new(int maxLength_) {
        if (maxLength_ < 0) {
            let maxLength_ = 0;
        }
        let maxLength = maxLength_;
        let len = 0;
        let data = Memory.alloc(maxLength);
        return this;
    }

    method void dispose() {
        do Memory.dealloc(data);
        do Memory.dealloc(this);
        return;
    }

    method int length() {
        return len;
    }

    method int charAt(int i) {
        var Array p;
        if ((i < 0) | (~(i < len))) {
            return 0;
        }
        let p = data + i;
        return p[0];
    }

    method String appendChar(int c) {
        var Array p;
        if (~(len < maxLength)) {
            return this; // full: ignore (compiler literals never overflow)
        }
        let p = data + len;
        let p[0] = c;
        let len = len + 1;
        return this;
    }

    method void eraseLastChar() {
        if (len > 0) {
            let len = len - 1;
        }
        return;
    }

    function int backSpace() {
        return 8; // SPEC keyboard mapping
    }

    function int newLine() {
        return 13; // SPEC keyboard mapping (Enter)
    }

    method void setInt(int n) {
        var int i;
        var int q;
        var int r;
        var int neg;
        var Array digits;
        var int nd;
        var Array p;
        let digits = Array.new(6); // max 5 digits + sign
        let nd = 0;
        let neg = 0;
        let len = 0; // rewrite from scratch
        if (n < 0) {
            let neg = 1;
            let n = -n;
            if (n < 0) {
                // n was -32768: emit '8' first and continue with 3276
                let digits[0] = 56; // '8'
                let nd = 1;
                let n = 3276;
            }
        }
        if (n = 0) {
            let digits[0] = 48; // '0'
            let nd = 1;
        }
        while (n > 0) {
            let q = Math.divide(n, 10);
            let r = n - (q * 10);
            let digits[nd] = 48 + r;
            let nd = nd + 1;
            let n = q;
        }
        if (neg = 1) {
            let p = data + len;
            let p[0] = 45; // '-'
            let len = len + 1;
        }
        while (nd > 0) {
            let nd = nd - 1;
            let p = data + len;
            let p[0] = digits[nd];
            let len = len + 1;
        }
        do digits.dispose();
        return;
    }
}
