/**
 * Screen: 512x256 monochrome framebuffer (words 0x4000..0x5FFF).
 * SPEC pixel mapping: word w = y*32 + x/16, pixel bit = 15 - (x mod 16), 1 = lit.
 * Lookup tables (built by init) avoid division: xw[i] = i/16, xm[i] = i mod 16.
 */
class Screen {
    static int color;         // 0 or 1
    static Array xw;          // x -> word offset within row (0..31)
    static Array xm;          // x -> bit index within word (0..15)
    static Array pow2;        // pow2[i] = 2^i
    static Array maskL;       // maskL[i] = bits i..0 set
    static Array maskR;       // maskR[i] = bits 15..(15-i) set

    function void init() {
        var int i;
        var int w;
        var int b;
        let color = 1;
        let xw = Array.new(512);
        let xm = Array.new(512);
        let pow2 = Array.new(16);
        let maskL = Array.new(16);
        let maskR = Array.new(16);
        // pow2 first (other tables depend on it)
        let pow2[0] = 1;
        let i = 1;
        while (i < 16) {
            let pow2[i] = pow2[i - 1] + pow2[i - 1];
            let i = i + 1;
        }
        // masks: maskL[i] = bits i..0; maskR[i] = bits 15..(15-i)
        let maskL[0] = 1;
        let maskR[0] = pow2[15];
        let i = 1;
        while (i < 16) {
            let maskL[i] = maskL[i - 1] + maskL[i - 1] + 1;
            let maskR[i] = maskR[i - 1] + pow2[15 - i];
            let i = i + 1;
        }
        // x -> (word, bit-in-word) tables, 512 entries, single pass (no multiply)
        let w = 0;
        let b = 0;
        let i = 0;
        while (i < 512) {
            let xw[i] = w;
            let xm[i] = b;
            let b = b + 1;
            if (b = 16) {
                let b = 0;
                let w = w + 1;
            }
            let i = i + 1;
        }
        do clearScreen();
        return;
    }

    function void setColor(int c) {
        if (c = 0) {
            let color = 0;
        } else {
            let color = 1;
        }
        return;
    }

    /** word offset within a row for pixel x (requires init). */
    function int wordOf(int x) {
        return xw[x];
    }

    /** bit index within a word for pixel x (requires init). */
    function int bitOf(int x) {
        return xm[x];
    }

    function void clearScreen() {
        var int i;
        var Array p;
        let p = 16384;
        let i = 0;
        while (i < 8192) {
            let p[i] = 0;
            let i = i + 1;
        }
        return;
    }

    function void drawPixel(int x, int y) {
        var Array p;
        var int mask;
        var int word;
        if ((x < 0) | (x > 511) | (y < 0) | (y > 255)) {
            return; // silently ignore out-of-range pixels
        }
        let p = 16384 + ((y * 32) + xw[x]);
        let word = p[0];
        let mask = pow2[15 - xm[x]];
        if (color = 1) {
            let p[0] = word | mask;
        } else {
            let p[0] = word & (~(mask));
        }
        return;
    }

    /** Horizontal run fill for one row: same-word and cross-word cases. */
    function void drawRow(int base, int x1, int x2) {
        var Array p;
        var int w1;
        var int w2;
        var int m1;
        var int m2;
        var int inner;
        var int word;
        var int w;
        if (x1 < 0) { let x1 = 0; }
        if (x2 > 511) { let x2 = 511; }
        if (x1 > x2) {
            return;
        }
        let w1 = xw[x1];
        let w2 = xw[x2];
        let m1 = maskL[15 - xm[x1]];
        let m2 = maskR[xm[x2]];
        let inner = m1 & m2; // bits strictly inside [x1..x2]
        let p = base + w1;
        if (w1 = w2) {
            let word = p[0];
            if (color = 1) {
                let p[0] = (word & (~(m1))) | inner;
            } else {
                let p[0] = word & (~(inner));
            }
            return;
        }
        // first word: bits from x1 to the right edge
        let word = p[0];
        if (color = 1) {
            let p[0] = word | m1;
        } else {
            let p[0] = word & (~(m1));
        }
        // middle words (full)
        let p = base + w1 + 1;
        let w = w1 + 1;
        while (w < w2) {
            if (color = 1) {
                let p[0] = -1;
            } else {
                let p[0] = 0;
            }
            let p = p + 1;
            let w = w + 1;
        }
        // last word: bits from the left edge to x2
        let p = base + w2;
        let word = p[0];
        if (color = 1) {
            let p[0] = word | m2;
        } else {
            let p[0] = word & (~(m2));
        }
        return;
    }

    function void drawRectangle(int x1, int y1, int x2, int y2) {
        var int y;
        var int t;
        var int base;
        if (x1 > x2) {
            let t = x1;
            let x1 = x2;
            let x2 = t;
        }
        if (y1 > y2) {
            let t = y1;
            let y1 = y2;
            let y2 = t;
        }
        // clip to the screen: a negative y1 would address the heap
        if (y1 < 0) {
            let y1 = 0;
        }
        if (y2 > 255) {
            let y2 = 255;
        }
        let base = 16384 + (y1 * 32);
        let y = y1;
        while (~(y2 < y)) {
            do drawRow(base, x1, x2);
            let base = base + 32;
            let y = y + 1;
        }
        return;
    }

    function void drawLine(int x1, int y1, int x2, int y2) {
        var int dx;
        var int dy;
        var int sx;
        var int sy;
        var int err;
        var int e2;
        let dx = Math.abs(x2 - x1);
        let dy = Math.abs(y2 - y1);
        if (x1 < x2) {
            let sx = 1;
        } else {
            let sx = -1;
        }
        if (y1 < y2) {
            let sy = 1;
        } else {
            let sy = -1;
        }
        let err = dx - dy;
        while (~((x1 = x2) & (y1 = y2))) {
            do drawPixel(x1, y1);
            let e2 = err + err;
            if (e2 > -dy) {
                let err = err - dy;
                let x1 = x1 + sx;
            }
            if (e2 < dx) {
                let err = err + dx;
                let y1 = y1 + sy;
            }
        }
        do drawPixel(x1, y1);
        return;
    }
}
